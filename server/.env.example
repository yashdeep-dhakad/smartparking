# ---- Copy this file to ".env" and fill in your own values ----
NODE_ENV=development
PORT=5000

# Local MongoDB (the database "parkwise" is created automatically on first write)
MONGO_URI=mongodb://127.0.0.1:27017/parkwise
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/parkwise?retryWrites=true&w=majority

# Any long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Razorpay TEST keys (Dashboard -> Test Mode -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
# Only needed if you set up a webhook (Dashboard -> Webhooks). Optional for local dev.
RAZORPAY_WEBHOOK_SECRET=

# Booking rules
HOLD_MINUTES=10
CANCEL_BEFORE_HOURS=2

# Transactional email (booking confirmations) sent to the user's registered address.
# Leave blank to run in demo mode (the email is written to the server log instead of being sent).
# Example for Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
#   SMTP_USER=you@gmail.com  SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ParkWise <no-reply@parkwise.local>

# Used ONLY by `npm run seed` to create the first admin account. Change these!
SEED_ADMIN_EMAIL=admin@parkwise.local
SEED_ADMIN_PASSWORD=ChangeMe@12345
